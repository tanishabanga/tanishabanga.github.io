# Local runs of the data scripts only (npm run data:update). The GitHub Action uses the built-in GITHUB_TOKEN instead.
# Copy to .env (git-ignored) and fill in. NEVER commit real values.
# Create a token at https://github.com/settings/personal-access-tokens (fine-grained, "Public repositories (read-only)", no extra permissions).
GITHUB_TOKEN=
# Optional; defaults to tanishabanga.
GITHUB_USERNAME=
